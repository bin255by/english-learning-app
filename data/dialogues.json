{
  "scenes": [
    {
      "id": "small-talk",
      "titleEn": "Small Talk",
      "titleZh": "闲聊",
      "descZh": "美国人日常寒暄常用表达。",
      "lines": [
        {
          "speaker": "A",
          "en": "How's it going?",
          "zh": "最近怎么样？",
          "keyExpressions": [
            { "en": "How's it going?", "zh": "最近怎么样？" },
            { "en": "Not bad.", "zh": "还不错。" }
          ]
        },
        {
          "speaker": "B",
          "en": "Not bad. How about you?",
          "zh": "还不错。你呢？",
          "keyExpressions": []
        },
        {
          "speaker": "A",
          "en": "I'm doing great, thanks.",
          "zh": "我挺好的，谢谢。",
          "keyExpressions": []
        },
        {
          "speaker": "B",
          "en": "Great. See you around!",
          "zh": "很好，回头见！",
          "keyExpressions": []
        }
      ],
      "tipsZh": [
        "美国人常用 How's it going 代替 How are you。",
        "回答 Pretty good. 或 Not bad. 就可以，不用真的描述近况。"
      ]
    },
    {
      "id": "greetings",
      "titleEn": "Greetings",
      "titleZh": "日常打招呼",
      "descZh": "见面和告别时最常用的几句话。",
      "lines": [
        {
          "speaker": "A",
          "en": "Good morning!",
          "zh": "早上好！",
          "keyExpressions": [
            { "en": "Good morning!", "zh": "早上好！" },
            { "en": "How have you been?", "zh": "你最近好吗？" }
          ]
        },
        {
          "speaker": "B",
          "en": "Morning! How have you been?",
          "zh": "早上好！你最近好吗？",
          "keyExpressions": []
        },
        {
          "speaker": "A",
          "en": "I've been busy, but I'm fine.",
          "zh": "最近挺忙，不过我还好。",
          "keyExpressions": []
        },
        {
          "speaker": "B",
          "en": "Take care!",
          "zh": "保重！",
          "keyExpressions": [
            { "en": "Take care!", "zh": "保重！" }
          ]
        }
      ],
      "tipsZh": [
        "在电梯、商店里，美国人常跟陌生人打招呼，回一句 Morning 就好。",
        "Take care 表示“保重”，离开时说很自然。"
      ]
    },
    {
  "id": "home-conversations",
  "titleEn": "Common Home Conversations",
  "titleZh": "家庭常用对话",
  "descZh": "家庭生活中常见问答：开关门、放冰箱、东西摆放、出门接人。",
  "lines": [
    {
      "speaker": "A",
      "en": "Should I open the door?",
      "zh": "我要开门吗？",
      "keyExpressions": [
        { "en": "Should I open the door?", "zh": "我要开门吗？" },
        { "en": "Keep it closed.", "zh": "让它关着。" },
        { "en": "Should I lock it?", "zh": "要锁门吗？" }
      ]
    },
    {
      "speaker": "B",
      "en": "No, keep it closed. It's cold outside.",
      "zh": "不用，让它关着。外面很冷。",
      "keyExpressions": []
    },
    {
      "speaker": "A",
      "en": "Okay. Should I lock it?",
      "zh": "好的。要锁门吗？",
      "keyExpressions": []
    },
    {
      "speaker": "B",
      "en": "Yes, please lock the door.",
      "zh": "要，请把门锁上。",
      "keyExpressions": []
    },
    {
      "speaker": "A",
      "en": "Should I put the leftovers in the fridge?",
      "zh": "剩菜要放冰箱吗？",
      "keyExpressions": [
        { "en": "Should I put the leftovers in the fridge?", "zh": "剩菜要放冰箱吗？" },
        { "en": "Put them in the fridge.", "zh": "把它们放进冰箱。" },
        { "en": "How long can we keep them?", "zh": "能放多久？" }
      ]
    },
    {
      "speaker": "B",
      "en": "Yes, please put them in the fridge.",
      "zh": "要，请把它们放进冰箱。",
      "keyExpressions": []
    },
    {
      "speaker": "A",
      "en": "How long can we keep them?",
      "zh": "能放多久？",
      "keyExpressions": []
    },
    {
      "speaker": "B",
      "en": "Two days, I think.",
      "zh": "我想两天吧。",
      "keyExpressions": []
    },
    {
      "speaker": "A",
      "en": "Where should I put these groceries?",
      "zh": "这些食品杂货该放哪儿？",
      "keyExpressions": [
        { "en": "Where should I put ...?", "zh": "……该放哪儿？" },
        { "en": "Put the vegetables on the bottom shelf.", "zh": "把蔬菜放在最下层。" },
        { "en": "What about ...?", "zh": "那……呢？" },
        { "en": "Stack them in the cabinet.", "zh": "把它们叠放在橱柜里。" }
      ]
    },
    {
      "speaker": "B",
      "en": "Put the vegetables on the bottom shelf.",
      "zh": "把蔬菜放在最下层。",
      "keyExpressions": []
    },
    {
      "speaker": "A",
      "en": "What about the dishes?",
      "zh": "那这些盘子呢？",
      "keyExpressions": []
    },
    {
      "speaker": "B",
      "en": "Stack them in the cabinet.",
      "zh": "把它们叠放在橱柜里。",
      "keyExpressions": []
    },
    {
      "speaker": "A",
      "en": "Do we need to go pick someone up?",
      "zh": "我们要出门去接人吗？",
      "keyExpressions": [
        { "en": "Do we need to go pick someone up?", "zh": "我们要出门去接人吗？" },
        { "en": "pick up", "zh": "接（人）" },
        { "en": "Should we leave now?", "zh": "我们要现在出发吗？" }
      ]
    },
    {
      "speaker": "B",
      "en": "Yes, we need to pick up your sister at six.",
      "zh": "要，我们六点要去接你妹妹。",
      "keyExpressions": []
    },
    {
      "speaker": "A",
      "en": "Should we leave now?",
      "zh": "我们要现在出发吗？",
      "keyExpressions": []
    },
    {
      "speaker": "B",
      "en": "Yes, let's go.",
      "zh": "要，走吧。",
      "keyExpressions": []
    }
  ],
  "tipsZh": [
    "家里问要不要做某事，常用 Should I ...? 或 Do you need me to ...?。",
    "放东西可以问 Where should I put ...?，回答用 Put it/them ...。",
    "接人常用 pick up，例如 pick up your sister。",
    "出门前可以确认 Should we leave now?"
  ]
},
    {
      "id": "shopping",
      "titleEn": "Shopping",
      "titleZh": "购物",
      "descZh": "在美国超市或商店买东西时的常用句。",
      "lines": [
        {
          "speaker": "A",
          "en": "Excuse me, where is the milk?",
          "zh": "打扰一下，牛奶在哪里？",
          "keyExpressions": [
            { "en": "Excuse me, where is ...", "zh": "打扰一下，……在哪里？" },
            { "en": "How much is this?", "zh": "这个多少钱？" }
          ]
        },
        {
          "speaker": "B",
          "en": "The milk is in aisle four.",
          "zh": "牛奶在第 4 号通道。",
          "keyExpressions": []
        },
        {
          "speaker": "A",
          "en": "How much is this?",
          "zh": "这个多少钱？",
          "keyExpressions": []
        },
        {
          "speaker": "B",
          "en": "It's three ninety-nine.",
          "zh": "三块九毛九。",
          "keyExpressions": []
        }
      ],
      "tipsZh": [
        "标价通常不含税，结账时会再加税。",
        "店员常问 Cash or card?（现金还是刷卡？）"
      ]
    },
    {
      "id": "asking-help",
      "titleEn": "Asking for Help",
      "titleZh": "寻求帮助",
      "descZh": "需要别人帮忙时的礼貌说法。",
      "lines": [
        {
          "speaker": "A",
          "en": "Could you help me, please?",
          "zh": "请帮我一下好吗？",
          "keyExpressions": [
            { "en": "Could you help me, please?", "zh": "请帮我一下好吗？" },
            { "en": "I don't understand.", "zh": "我不明白。" }
          ]
        },
        {
          "speaker": "B",
          "en": "Of course. What do you need?",
          "zh": "当然可以。你需要什么？",
          "keyExpressions": []
        },
        {
          "speaker": "A",
          "en": "I don't understand this form.",
          "zh": "我看不懂这张表。",
          "keyExpressions": []
        },
        {
          "speaker": "B",
          "en": "Let me show you how to fill it out.",
          "zh": "我来教你怎么填。",
          "keyExpressions": []
        }
      ],
      "tipsZh": [
        "开口先说 Excuse me 或 Could you help me，会显得更有礼貌。",
        "I don't understand 是最实用的求助句，听不懂时直接说这句。"
      ]
    },
    {
      "id": "restaurant",
      "titleEn": "At the Restaurant",
      "titleZh": "餐厅",
      "descZh": "点餐、要水、买单时的常用表达。",
      "lines": [
        {
          "speaker": "A",
          "en": "A table for two, please.",
          "zh": "请给我们两人桌位。",
          "keyExpressions": [
            { "en": "A table for two, please.", "zh": "请给我们两人桌位。" },
            { "en": "I'd like to order.", "zh": "我要点餐。" },
            { "en": "Check, please.", "zh": "买单，谢谢。" }
          ]
        },
        {
          "speaker": "B",
          "en": "Here is the menu. What would you like to drink?",
          "zh": "这是菜单。你们想喝点什么？",
          "keyExpressions": []
        },
        {
          "speaker": "A",
          "en": "I'd like a glass of water, please.",
          "zh": "我要一杯水，谢谢。",
          "keyExpressions": []
        },
        {
          "speaker": "B",
          "en": "Enjoy your meal!",
          "zh": "用餐愉快！",
          "keyExpressions": []
        }
      ],
      "tipsZh": [
        "小费一般给 15%–20%，结账时可以在刷卡小票上写。",
        "想结账就对服务员说 Check, please.，不要挥手大声喊。"
      ]
    },
    {
