    {
      "id": "small-talk",
      "titleEn": "Small Talk",
      "titleZh": "闲聊",
      "descZh": "美国人日常寒暄常用表达。",
      "lines": [
        {
          "speaker": "A",
          "en": "How's it going?",
          "zh": "最近怎么样？",
          "keyExpressions": [
            { "en": "How's it going?", "zh": "最近怎么样？" },
            { "en": "Not bad.", "zh": "还不错。" }
          ]
        },
        {
          "speaker": "B",
          "en": "Not bad. How about you?",
          "zh": "还不错。你呢？",
          "keyExpressions": []
        },
        {
          "speaker": "A",
          "en": "I'm doing great, thanks.",
          "zh": "我挺好的，谢谢。",
          "keyExpressions": []
        },
        {
          "speaker": "B",
          "en": "Great. See you around!",
          "zh": "很好，回头见！",
          "keyExpressions": []
        }
      ],
      "tipsZh": [
        "美国人常用 How's it going 代替 How are you。",
        "回答 Pretty good. 或 Not bad. 就可以，不用真的描述近况。"
      ]
    },
    {
      "id": "greetings",
      "titleEn": "Greetings",
