    {
      "id": "library-card-west",
      "titleEn": "Getting a Library Card",
      "titleZh": "办借书证",
      "descZh": "在图书馆办借书证、问能借多少本书的简单对话。",
      "lines": [
        {
          "speaker": "A",
          "en": "Can I get a library card here?",
          "zh": "我可以在这里办借书证吗？",
          "keyExpressions": [
            { "en": "library card", "zh": "借书证" }
          ]
        },
        {
          "speaker": "B",
          "en": "Sure. Do you live in this city?",
          "zh": "可以。你住在这个城市吗？",
          "keyExpressions": []
        },
        {
          "speaker": "A",
          "en": "Yes, I live nearby.",
          "zh": "是的，我住在附近。",
          "keyExpressions": []
        },
        {
          "speaker": "B",
          "en": "Then please fill out this form.",
          "zh": "那请填一下这张表。",
          "keyExpressions": [
            { "en": "fill out this form", "zh": "填这张表" }
          ]
        },
        {
          "speaker": "A",
          "en": "How many books can I borrow?",
          "zh": "我可以借多少本书？",
