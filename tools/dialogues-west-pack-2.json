{
  "scenes": [
    {
      "id": "airport-checkin-west",
      "titleEn": "Airport Check-In",
      "titleZh": "机场值机",
      "descZh": "在机场找值机柜台、出示护照、托运行李的简单对话。",
      "lines": [
        {
          "speaker": "A",
          "en": "Excuse me, where is the check-in counter?",
          "zh": "打扰一下，值机柜台在哪里？",
          "keyExpressions": [
            { "en": "Excuse me, where is ...?", "zh": "打扰一下，……在哪里？" },
            { "en": "check-in counter", "zh": "值机柜台" }
          ]
        },
        {
          "speaker": "B",
          "en": "It's over there, next to the elevator.",
          "zh": "在那边，电梯旁边。",
          "keyExpressions": []
        },
        {
          "speaker": "A",
          "en": "Thanks. Can I check in here?",
          "zh": "谢谢。我可以在这里办值机吗？",
          "keyExpressions": [
            { "en": "check in", "zh": "办理值机" }
          ]
        },
        {
          "speaker": "B",
          "en": "Yes. May I see your passport, please?",
          "zh": "可以。请给我看一下您的护照好吗？",
          "keyExpressions": [
            { "en": "May I see your passport, please?", "zh": "请给我看一下您的护照好吗？" }
          ]
        },
        {
          "speaker": "A",
          "en": "Sure, here it is.",
          "zh": "好的，在这里。",
          "keyExpressions": []
        },
        {
          "speaker": "B",
          "en": "Do you have any bags to check?",
          "zh": "您有需要托运的行李吗？",
          "keyExpressions": [
            { "en": "bags to check", "zh": "需要托运的行李" }
          ]
        },
        {
          "speaker": "A",
          "en": "Just one bag, please.",
          "zh": "只有一件行李。",
          "keyExpressions": []
        },
        {
          "speaker": "B",
          "en": "Okay. Here is your boarding pass.",
          "zh": "好的。这是您的登机牌。",
          "keyExpressions": [
            { "en": "boarding pass", "zh": "登机牌" }
          ]
        }
      ],
      "tipsZh": [
        "美国机场先找 check-in counter（值机柜台）。",
        "托运行李说 bags to check，随身行李是 carry-on。",
        "check in 既指办值机，也指酒店入住。"
      ]
    },
    {
      "id": "airport-security-west",
      "titleEn": "Going Through Security",
      "titleZh": "过机场安检",
      "descZh": "在美国机场过安检时，脱鞋、放托盘、电脑单独过检的对话。",
      "lines": [
        {
          "speaker": "A",
          "en": "Do I need to take off my shoes?",
          "zh": "我需要脱鞋吗？",
          "keyExpressions": [
            { "en": "take off my shoes", "zh": "脱鞋" }
          ]
        },
        {
          "speaker": "B",
          "en": "Yes, please put them in the bin.",
          "zh": "是的，请把它们放进托盘。",
          "keyExpressions": [
            { "en": "bin", "zh": "安检托盘" }
          ]
        },
        {
          "speaker": "A",
          "en": "What about my water bottle?",
          "zh": "那我的水瓶呢？",
          "keyExpressions": []
        },
        {
          "speaker": "B",
          "en": "Sorry, no water past this line.",
          "zh": "抱歉，水不能带过这条线。",
          "keyExpressions": []
        },
        {
          "speaker": "A",
          "en": "Okay. Where do I put my laptop?",
          "zh": "好的。笔记本电脑放哪里？",
          "keyExpressions": []
        },
        {
          "speaker": "B",
          "en": "In a separate bin, please.",
          "zh": "请单独放一个托盘。",
          "keyExpressions": [
            { "en": "In a separate bin, please.", "zh": "请单独放一个托盘。" }
          ]
        }
      ],
      "tipsZh": [
        "美国安检常要脱鞋、脱外套，电脑单独放一个托盘。",
        "Bin 是安检用的塑料托盘。",
        "瓶装水不能过安检，进去后可以再买。"
      ]
    },
    {
      "id": "baggage-claim-west",
      "titleEn": "At Baggage Claim",
      "titleZh": "取行李",
      "descZh": "下飞机后找行李提取处、问转盘号码的简单对话。",
      "lines": [
        {
          "speaker": "A",
          "en": "Where is baggage claim?",
          "zh": "行李提取处在哪里？",
          "keyExpressions": [
            { "en": "baggage claim", "zh": "行李提取处" }
          ]
        },
        {
          "speaker": "B",
          "en": "Go down the stairs and turn right.",
          "zh": "下楼梯然后右转。",
          "keyExpressions": []
        },
        {
          "speaker": "A",
          "en": "Which carousel is for my flight?",
          "zh": "我的航班在哪个转盘？",
          "keyExpressions": [
            { "en": "carousel", "zh": "行李转盘" }
          ]
        },
        {
          "speaker": "B",
          "en": "I think it's carousel four.",
          "zh": "我想是 4 号转盘。",
          "keyExpressions": []
        },
        {
          "speaker": "A",
          "en": "How long does it take?",
          "zh": "要等多久？",
          "keyExpressions": [
            { "en": "How long does it take?", "zh": "要等多久？" }
          ]
        },
        {
          "speaker": "B",
          "en": "About ten minutes.",
          "zh": "大约十分钟。",
          "keyExpressions": []
        }
      ],
      "tipsZh": [
        "Baggage claim 是行李提取处，标志是一个箱子。",
        "Carousel 是行李转盘，机场屏幕会写航班和转盘号。",
        "行李不见时问：Where can I find lost luggage?"
      ]
    },
    {
      "id": "car-rental-west",
      "titleEn": "Renting a Car",
      "titleZh": "租车",
      "descZh": "在美国租车：出示驾照、选保险、问还车地点的简单对话。",
      "lines": [
        {
          "speaker": "A",
          "en": "Hi, I have a car reservation.",
          "zh": "你好，我预订了车。",
          "keyExpressions": [
            { "en": "I have a car reservation.", "zh": "我预订了车。" }
          ]
        },
        {
          "speaker": "B",
          "en": "Sure. May I see your driver's license?",
          "zh": "好的。请给我看一下您的驾照。",
          "keyExpressions": [
            { "en": "driver's license", "zh": "驾照" }
          ]
        },
        {
          "speaker": "A",
          "en": "Here you go. I need a small car.",
          "zh": "给你。我需要一辆小车。",
          "keyExpressions": []
        },
        {
          "speaker": "B",
          "en": "Okay. Do you want full insurance?",
          "zh": "好的。您要全险吗？",
          "keyExpressions": [
            { "en": "insurance", "zh": "保险" }
          ]
        },
        {
          "speaker": "A",
          "en": "Yes, please. Where do I return it?",
          "zh": "要。我在哪里还车？",
          "keyExpressions": [
            { "en": "Where do I return it?", "zh": "我在哪里还车？" }
          ]
        },
        {
          "speaker": "B",
          "en": "Return it to this lot, right here.",
          "zh": "还到这个停车场，就在这儿。",
          "keyExpressions": [
            { "en": "return the car", "zh": "还车" }
          ]
        },
        {
          "speaker": "A",
          "en": "Great. Thank you very much.",
          "zh": "太好了。非常感谢。",
          "keyExpressions": []
        }
      ],
      "tipsZh": [
        "租车要带 driver's license（驾照）。",
        "Insurance 是保险，Full insurance 是全险。",
        "Lot 指停车场，还车问 return the car 就行。"
      ]
    },
    {
      "id": "bus-ride-west",
      "titleEn": "Taking the Bus",
      "titleZh": "坐公交车",
      "descZh": "在美国坐公交：问是否到某地、车费多少、能不能换乘。",
      "lines": [
        {
          "speaker": "A",
          "en": "Does this bus go downtown?",
          "zh": "这趟车去市中心吗？",
          "keyExpressions": [
            { "en": "Does this bus go ...?", "zh": "这趟车去……吗？" },
            { "en": "downtown", "zh": "市中心" }
          ]
        },
        {
          "speaker": "B",
          "en": "Yes, it stops on Main Street.",
          "zh": "去，它在主街停。",
          "keyExpressions": []
        },
        {
          "speaker": "A",
          "en": "How much is the fare?",
          "zh": "车费多少？",
          "keyExpressions": [
            { "en": "fare", "zh": "车费" }
          ]
        },
        {
          "speaker": "B",
          "en": "Two dollars and fifty cents.",
          "zh": "两块五美元。",
          "keyExpressions": []
        },
        {
          "speaker": "A",
          "en": "Do you give transfers?",
          "zh": "你们给换乘票吗？",
          "keyExpressions": [
            { "en": "transfer", "zh": "换乘票" }
          ]
        },
        {
          "speaker": "B",
          "en": "Yes, please ask the driver.",
          "zh": "给，请跟司机说。",
          "keyExpressions": []
        }
      ],
      "tipsZh": [
        "车费叫 fare，换乘票叫 transfer。",
        "上车前问 Does this bus go ...? 最保险。",
        "很多城市要自己准备零钱，或用公交卡。"
      ]
    },
    {
