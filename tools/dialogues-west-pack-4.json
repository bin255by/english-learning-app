            { "en": "parking meter", "zh": "停车缴费机" }
          ]
        },
        {
          "speaker": "B",
          "en": "Put in coins or use a card.",
          "zh": "投币或者刷卡。",
          "keyExpressions": []
        },
        {
          "speaker": "A",
          "en": "How long can I park?",
          "zh": "我可以停多久？",
          "keyExpressions": [
            { "en": "How long can I park?", "zh": "我可以停多久？" }
          ]
        },
        {
          "speaker": "B",
          "en": "Two hours at most.",
          "zh": "最多两小时。",
          "keyExpressions": [
            { "en": "at most", "zh": "最多" }
          ]
        },
        {
          "speaker": "A",
          "en": "Is it free on Sunday?",
          "zh": "周日免费吗？",
          "keyExpressions": [
            { "en": "Is it free on Sunday?", "zh": "周日免费吗？" }
          ]
        },
        {
          "speaker": "B",
          "en": "Yes, and after six every day.",
          "zh": "免费，而且每天六点以后也免费。",
          "keyExpressions": []
