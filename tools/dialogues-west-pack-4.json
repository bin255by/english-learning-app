        {
          "speaker": "A",
          "en": "Does it have water too?",
          "zh": "也能接水吗？",
          "keyExpressions": [
            { "en": "water hookup", "zh": "接水口" }
          ]
        },
        {
          "speaker": "B",
          "en": "Yes, water and power both.",
