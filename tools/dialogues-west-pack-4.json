    {
      "id": "tire-shop-west",
      "titleEn": "At the Tire Shop",
      "titleZh": "补轮胎",
      "descZh": "轮胎漏气到修车行：说哪条轮、问补胎要多久多少钱。",
      "lines": [
        {
          "speaker": "A",
          "en": "My tire is losing air.",
          "zh": "我的轮胎漏气。",
          "keyExpressions": [
            { "en": "tire", "zh": "轮胎" }
