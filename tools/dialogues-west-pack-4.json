        {
          "speaker": "B",
          "en": "Let's take a look. Which one?",
          "zh": "我们看看。哪一条？",
          "keyExpressions": [
            { "en": "Let's take a look.", "zh": "我们看一下。" }
          ]
        },
        {
          "speaker": "A",
          "en": "The back right one.",
          "zh": "右后轮。",
          "keyExpressions": [
            { "en": "back right one", "zh": "右后轮" }
          ]
        },
        {
          "speaker": "B",
          "en": "There is a nail in it.",
          "zh": "里面扎了个钉子。",
          "keyExpressions": [
            { "en": "nail", "zh": "钉子" }
          ]
        },
        {
          "speaker": "A",
          "en": "Can you fix it today?",
          "zh": "今天能修好吗？",
          "keyExpressions": [
            { "en": "fix it", "zh": "把它修好" }
          ]
        },
        {
          "speaker": "B",
          "en": "Yes, about twenty minutes.",
          "zh": "可以，大约二十分钟。",
          "keyExpressions": []
        },
        {
          "speaker": "A",
          "en": "Great. How much?",
          "zh": "好。多少钱？",
          "keyExpressions": []
        },
        {
          "speaker": "B",
          "en": "Twenty-five dollars for a patch.",
          "zh": "补胎二十五美元。",
          "keyExpressions": [
            { "en": "patch", "zh": "补胎" }
          ]
        }
