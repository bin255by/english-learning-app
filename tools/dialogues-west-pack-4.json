{
  "scenes": [
    {
      "id": "christmas-tree-farm-west",
      "titleEn": "At a Christmas Tree Farm",
      "titleZh": "在圣诞树农场",
      "descZh": "冬天到农场挑树、借锯子、把树绑到车顶。",
      "lines": [
        {
          "speaker": "A",
          "en": "How much are the trees?",
          "zh": "这些树多少钱？",
          "keyExpressions": [
            { "en": "How much are the trees?", "zh": "树多少钱？" }
          ]
        },
        {
          "speaker": "B",
          "en": "Forty dollars, any size.",
          "zh": "四十美元，不分大小。",
          "keyExpressions": []
        },
        {
          "speaker": "A",
          "en": "Do you have a saw we can borrow?",
          "zh": "有锯子可以借吗？",
          "keyExpressions": [
            { "en": "saw", "zh": "锯子" }
          ]
        },
        {
          "speaker": "B",
          "en": "Yes, the saws are by the barn.",
          "zh": "有，锯子在谷仓旁边。",
          "keyExpressions": [
            { "en": "barn", "zh": "谷仓" }
          ]
        },
        {
          "speaker": "A",
          "en": "Which tree looks good to you?",
          "zh": "你觉得哪棵树好？",
          "keyExpressions": []
        },
        {
          "speaker": "B",
          "en": "The tall one in the corner.",
          "zh": "角落里那棵高的。",
          "keyExpressions": []
        },
        {
          "speaker": "A",
          "en": "Great. Let's cut it down.",
          "zh": "好。我们把它锯下来。",
          "keyExpressions": [
            { "en": "cut it down", "zh": "把它锯下来" }
          ]
        },
        {
          "speaker": "B",
          "en": "I'll help you tie it to the car.",
          "zh": "我帮你把树绑到车上。",
          "keyExpressions": [
            { "en": "tie it to the car", "zh": "把它绑到车上" }
          ]
        }
      ],
      "tipsZh": [
        "农场圣诞树按棵卖，可以自己挑、自己锯。",
        "锯子 saw 一般现场能借，绳子最好自己带。",
        "树买回家要立在装水的底座里，每天加水。"
      ]
    },
    {
      "id": "phone-store-sim-west",
      "titleEn": "Buying a SIM Card",
      "titleZh": "买电话卡",
      "descZh": "在手机店买预付费卡：问流量、能不能保留原号码。",
      "lines": [
        {
          "speaker": "A",
          "en": "I need a SIM card for my phone.",
          "zh": "我需要一张手机卡。",
          "keyExpressions": [
            { "en": "SIM card", "zh": "手机卡" }
          ]
        },
        {
          "speaker": "B",
          "en": "Do you want prepaid or monthly?",
          "zh": "你要预付费还是按月付费？",
          "keyExpressions": [
            { "en": "prepaid", "zh": "预付费" }
          ]
        },
        {
          "speaker": "A",
          "en": "Prepaid, please. How much data?",
          "zh": "预付费。有多少流量？",
          "keyExpressions": [
            { "en": "data", "zh": "流量" }
          ]
        },
        {
          "speaker": "B",
          "en": "Thirty dollars for ten gigabytes.",
          "zh": "三十美元 10 GB。",
          "keyExpressions": []
        },
        {
          "speaker": "A",
          "en": "Can I keep my old number?",
          "zh": "可以保留我原来的号码吗？",
          "keyExpressions": [
            { "en": "keep my old number", "zh": "保留原来的号码" }
          ]
        },
        {
          "speaker": "B",
          "en": "Yes, we can move it over.",
          "zh": "可以，我们帮你转过来。",
          "keyExpressions": [
            { "en": "move it over", "zh": "把号码转过来" }
          ]
        },
        {
          "speaker": "A",
          "en": "Great. Let's do that.",
          "zh": "好，就这么办。",
          "keyExpressions": []
        }
      ],
      "tipsZh": [
        "美国常见预付费卡 prepaid，按月套餐叫 monthly plan。",
        "流量说 data，单位是 gigabytes（GB）。",
        "换运营商通常能把旧号码转过来：keep my old number。"
      ]
    },
    {
      "id": "board-game-night-west",
      "titleEn": "Board Game Night",
      "titleZh": "桌游夜",
      "descZh": "朋友家玩桌游：问规则、人数和轮次。",
      "lines": [
        {
          "speaker": "A",
          "en": "Are we playing a board game tonight?",
          "zh": "今晚我们玩桌游吗？",
          "keyExpressions": [
            { "en": "board game", "zh": "桌游" }
          ]
        },
        {
          "speaker": "B",
          "en": "Yes. Do you know how to play this one?",
          "zh": "玩。你会玩这个吗？",
          "keyExpressions": []
        },
        {
          "speaker": "A",
          "en": "No, can you show me the rules?",
          "zh": "不会，你能给我讲讲规则吗？",
          "keyExpressions": [
            { "en": "rules", "zh": "规则" }
          ]
        },
        {
          "speaker": "B",
          "en": "Sure. It takes about ten minutes.",
          "zh": "没问题。大约十分钟就讲完。",
          "keyExpressions": []
        },
        {
          "speaker": "A",
          "en": "How many people can play?",
          "zh": "几个人能玩？",
          "keyExpressions": []
        },
        {
          "speaker": "B",
          "en": "Up to six. We have five now.",
          "zh": "最多六个人。我们现在五个。",
          "keyExpressions": [
            { "en": "up to six", "zh": "最多六个人" }
          ]
        },
        {
          "speaker": "A",
          "en": "Perfect. Let's start.",
          "zh": "正好。开始吧。",
          "keyExpressions": []
        }
      ],
      "tipsZh": [
        "Board game 是桌游，rules 是规则；骰子叫 dice。",
        "轮到你说 It's your turn.，赢了一局说 win a round。",
        "桌游夜常配零食和汽水，带一点去很受欢迎。"
      ]
    },
    {
      "id": "borrow-tools-west",
      "titleEn": "Borrowing Tools",
      "titleZh": "向邻居借工具",
      "descZh": "向邻居借梯子换灯泡，说好什么时候还。",
      "lines": [
        {
          "speaker": "A",
          "en": "Hi, can I borrow a ladder?",
          "zh": "你好，可以借一下梯子吗？",
          "keyExpressions": [
            { "en": "borrow", "zh": "借（入）" }
          ]
        },
        {
          "speaker": "B",
          "en": "Sure. What do you need it for?",
          "zh": "可以。你借来做什么？",
          "keyExpressions": [
            { "en": "What do you need it for?", "zh": "你借来做什么？" }
          ]
        },
        {
          "speaker": "A",
          "en": "I need to change a light bulb.",
          "zh": "我要换个灯泡。",
          "keyExpressions": [
            { "en": "light bulb", "zh": "灯泡" }
          ]
        },
        {
          "speaker": "B",
          "en": "Okay, it's in the garage.",
          "zh": "好，在车库里。",
          "keyExpressions": [
            { "en": "garage", "zh": "车库" }
          ]
        },
        {
          "speaker": "A",
          "en": "I'll bring it back tonight.",
          "zh": "我今晚就还回来。",
          "keyExpressions": [
            { "en": "bring it back", "zh": "还回来" }
          ]
        },
        {
          "speaker": "B",
          "en": "No rush. Take your time.",
          "zh": "不着急，慢慢来。",
          "keyExpressions": [
            { "en": "No rush.", "zh": "不着急。" }
          ]
        }
      ],
      "tipsZh": [
        "借进来用 borrow，还回去用 return 或 bring it back。",
        "车库 garage 里通常放着梯子、工具和割草机。",
        "No rush 是“不着急”，邻居之间很常用。"
      ]
    },
    {
      "id": "stargazing-west",
      "titleEn": "Going Stargazing",
      "titleZh": "去看星空",
      "descZh": "在远离城市灯光的地方看星星：几点去、带什么。",
      "lines": [
        {
          "speaker": "A",
          "en": "Is this a good place for stargazing?",
          "zh": "这里适合看星星吗？",
          "keyExpressions": [
            { "en": "stargazing", "zh": "观星" }
          ]
        },
        {
          "speaker": "B",
          "en": "Yes, there are no city lights here.",
          "zh": "适合，这里没有城市灯光。",
          "keyExpressions": [
            { "en": "city lights", "zh": "城市灯光" }
          ]
        },
        {
          "speaker": "A",
          "en": "When is the best time?",
          "zh": "什么时候最好？",
          "keyExpressions": []
        },
        {
          "speaker": "B",
          "en": "After ten, when the moon is down.",
          "zh": "十点以后，月亮落下去的时候。",
          "keyExpressions": []
        },
        {
          "speaker": "A",
          "en": "Should I bring a flashlight?",
          "zh": "要带手电筒吗？",
          "keyExpressions": [
            { "en": "flashlight", "zh": "手电筒" }
          ]
        },
        {
          "speaker": "B",
          "en": "Yes, but use the red light mode.",
          "zh": "要，但用红光模式。",
          "keyExpressions": [
            { "en": "red light mode", "zh": "红光模式" }
          ]
        },
        {
          "speaker": "A",
          "en": "Good idea. Thanks for the tip.",
          "zh": "好主意，谢谢提醒。",
          "keyExpressions": []
        }
      ],
      "tipsZh": [
        "看星星要远离城市灯光 city lights，越黑越好。",
        "手电筒开红光模式，眼睛适应得快，看星更清楚。",
        "月亮落下后（moon is down）星光最亮，带件外套。"
      ]
    },
    {
      "id": "state-park-pass-west",
      "titleEn": "Buying a Park Pass",
      "titleZh": "买州立公园年票",
      "descZh": "在州立公园问年票价格、能不能通用多个公园。",
      "lines": [
        {
          "speaker": "A",
          "en": "Do you sell annual passes?",
          "zh": "你们卖年票吗？",
          "keyExpressions": [
            { "en": "annual pass", "zh": "年票" }
          ]
        },
        {
          "speaker": "B",
          "en": "Yes, it's eighty dollars for a year.",
          "zh": "卖，一年八十美元。",
          "keyExpressions": []
        },
        {
          "speaker": "A",
          "en": "Does it work in other parks?",
          "zh": "在别的公园也能用吗？",
          "keyExpressions": [
            { "en": "work in other parks", "zh": "在别的公园也能用" }
          ]
        },
        {
          "speaker": "B",
          "en": "Yes, in all state parks.",
          "zh": "可以，所有州立公园都行。",
          "keyExpressions": []
        },
        {
          "speaker": "A",
          "en": "That's a good deal.",
          "zh": "那挺划算的。",
          "keyExpressions": [
            { "en": "a good deal", "zh": "很划算" }
          ]
        },
        {
          "speaker": "B",
          "en": "Yes, two visits pay it back.",
          "zh": "是啊，来两次就回本了。",
          "keyExpressions": []
        }
      ],
      "tipsZh": [
        "Annual pass 是年票，一年内不限次数进州立公园。",
        "单次入园费常按车收，叫 day-use fee。",
        "常来玩买年票更划算：two visits pay it back。"
      ]
    },
